{
    "global": {
        "snowflake_source_name": "net.snowflake.spark.snowflake",
        "s3_client_name": "s3",
        "json_decode": "utf-8",
        "http_auth_user": "opensearch.net.http.auth.user",
        "http_auth_pass": "opensearch.net.http.auth.pass"

    },
    "environment": {
        "dev": {
            "snowflake_db_secret_name": "cdp-edw-sf-mirror-glue-dev",
            "es_secret": "cdp-edw-os-strategic-glue-dev",
            "database": "ENT_LEARN_DEV_DB",
            "role": "ENT_LEARN_OWNER_DEV_ROLE",
            "options": {
                "opensearch.nodes": "vpc-cdp-os-dev-b5ne3oko4ltuu5ygyjhltatiny.us-east-1.es.amazonaws.com",
                "opensearch.port": 443,
                "opensearch.nodes.wan.only": "true",
                "opensearch.net.ssl": "true",
                "opensearch.output.json": "true",
                "opensearch.spark.dataframe.write.null": "true",
                "opensearch.batch.size.entries": 1000
            }
        },
        "qa": {
            "snowflake_db_secret_name": "cdp-edw-sf-mirror-glue-qa",
            "es_secret": "cdp-edw-os-strategic-glue-qa",
            "database": "ENT_LEARN_QA_DB",
            "role": "ENT_LEARN_OWNER_QA_ROLE",
            "options": {
                "opensearch.nodes": "vpc-cdp-os-qa-vk2lfqbwzdu2wnpdo4pyjgzu3e.us-east-1.es.amazonaws.com",
                "opensearch.port": 443,
                "opensearch.nodes.wan.only": "true",
                "opensearch.net.ssl": "true",
                "opensearch.output.json": "true",
                "opensearch.spark.dataframe.write.null": "true",
                "opensearch.batch.size.entries": 1000
            }
        },
        "prod": {
            "snowflake_db_secret_name": "cdp-edw-sf-mirror-glue-prod",
            "es_secret": "cdp-edw-os-strategic-glue-prod",
            "database": "ENT_LEARN_PROD_DB",
            "role": "ENT_LEARN_OWNER_PROD_ROLE",
            "options": {
                "opensearch.nodes": "vpc-cdp-os-prod-e32i2bbtwqlipdkggcqpsjsjcu.us-east-1.es.amazonaws.com",
                "opensearch.port": 443,
                "opensearch.nodes.wan.only": "true",
                "opensearch.net.ssl": "true",
                "opensearch.output.json": "true",
                "opensearch.spark.dataframe.write.null": "true",
                "opensearch.batch.size.entries": 1000
            }
        }
    },
    "job": {
        "name": "CONSUME_COURSE_CATALOG_SF_TO_ES_GLUE",
        "environment": "dev",
        "spark_options": [
            "set spark.sql.legacy.timeParserPolicy=LEGACY", "set spark.sql.ansi.enabled=False"
        ]
    },
    "stages": [
	{
            "load_data_from_sf_to_es":
			{
                "sources": [{
                        "type": "snowflake",
                        "schema": "DATA",
                        "tmp_vw_query_map": [{
                                "VW_TRAINING_REF": [false, "SELECT TRAINING_OBJECT_ID, TRAINING_TYPE, ACTIVE_INACTIVE_FLAG, EVENT_NUMBER, TRAINING_TITLE, TRAINING_HOURS, TRAINING_PRICE, TRAINING_PROVIDER,FIRM_OR_LOCAL, DELIVERY_METHOD, COURSE_OWNER_FIRMWIDE_LEARNING, COURSE_OWNER_LOCAL_OFFICE, KLP_FRAMEWORK, COURSE_PRIORITY, COURSE_LEVEL, TARGET_AUDIENCE, TRAINING_DESCRIPTION1, TRAINING_DESCRIPTION2, SOURCE_SYSTEM, TRAINING_AVAILABILITY, SOURCE_DEEPLINK, MARKETING_DESCRIPTION, CREATION_DATE, UPDATE_DATE,IS_LATEST_TRAINING_VERSION,REGISTER_AND_LAUNCH_DEEPLINK,TRAINING_VERSION_RELATIONSHIP from DATA.VW_TRAINING_REF"],
                                "VW_TRAINING_TAXONOMY_TAG": [false, "select TRAINING_OBJECT_ID, TAG_TYPE_TAG_LINEAGE, UPDATE_DATE from DATA.VW_TRAINING_TAXONOMY_TAG"]
                            }
                        ],
                        "tmp_vw_table_map": []
                    }
                ],
                "targets": [
					{
                        "name": "course_catalog",
                        "type": "elasticsearch",
                        "target_es_columns":
						[
							{ "training_ref_sdf": ["trainingObjectId", "trainingType", "activeInactiveFlag", "eventNumber", "trainingTitle","trainingHours","trainingPrice","trainingProvider","firmOrLocal","deliveryMethod","courseOwnerFirmwideLearning","courseOwnerLocalOffice" ,"klpFramework","coursePriority","courseLevel", "targetAudience", "trainingDescription1","trainingDescription2","sourceSystem","trainingAvailability","sourceDeeplink","marketingDescription","createDate","updateDate","isLatestTrainingVersion", "registerAndLaunchDeeplink", "trainingVersionRelationship"] },
                            { "training_taxonomy_tag_sdf": ["trainingObjectId","tagTypeTagLineage", "updateDate"] }

                        ],
						"es_index":"course_catalog",
						"es_index_prev": "course_catalog_prev",
						"es_index_alias": "course_catalog_alias",
						"region": "us-east-1",								
						"write_mode":"append",
						"write_format": "org.opensearch.spark.sql",
						"tzvalue":"America/New_York",
                        "schema_key":"CDP-API-Schemas/Strategic-ES-Schemas/course_catalog.json"
                    }

                ]
            }
			}
			]

}
